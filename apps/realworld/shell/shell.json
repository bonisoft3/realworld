          "shell/shared/chrome.css",
          "shell/shared/system.css"
        ]
      },
      "ssr": "spa",
      "states": [
        "loading",
        "empty",
        "populated",
        "populated-dark"
      ]
    },
    {
      "keep": 0,
      "path": "/editor",
      "screen": "editor",
      "nav": {
        "key": "nav_editor",
        "label": "New Article",
        "labels": {
          "en": "New Article",
          "zh": "新建文章",
          "hi": "नया लेख",
          "es": "Nuevo artículo",
          "fr": "Nouvel article",
          "ar": "مقال جديد",
          "bn": "নতুন লেখা",
          "pt": "Novo Artigo",
          "ru": "Новая статья",
          "ur": "نئی تحریر",
          "id": "Artikel Baru",
          "de": "Neuer Artikel",
          "ja": "新規記事",
