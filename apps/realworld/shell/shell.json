          "ar": "المحفوظات",
          "bn": "সংরক্ষিত",
          "pt": "Salvos",
          "ru": "Сохранённое",
          "ur": "محفوظ شدہ",
          "id": "Tersimpan",
          "de": "Gemerkt",
