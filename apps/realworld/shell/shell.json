  "tables": [
    "app_user",
    "article",
    "article_stats",
    "article_tag",
    "bookmark",
    "comment",
    "favorite",
    "favorite_count",
    "favorite_index",
    "follow",
    "me",
    "tag_count"
  ],
  "schema": {
    "app_user": {
      "durability": "server",
      "fields": [
        {
          "name": "id",
          "pk": true,
          "type": "uuid",
          "required": true
        },
        {
          "bounds": {
            "sizeMin": 1
          },
          "name": "handle",
          "type": "string",
          "required": true,
          "unique": true
        },
        {
          "bounds": {
            "sizeMax": 60
          },
          "name": "display_name",
          "type": "string",
          "required": false
        },
        {
          "bounds": {
            "sizeMax": 300
          },
          "name": "bio",
          "type": "string",
          "required": false
        },
        {
          "bounds": {
            "sizeMax": 2048
          },
          "name": "image_url",
          "type": "string",
          "required": false
        },
        {
          "default": "now()",
          "name": "created_at",
          "type": "timestamp",
          "required": true
        }
      ]
    },
    "me": {
      "durability": "live",
      "fields": [
        {
          "name": "id",
          "pk": true,
          "type": "uuid",
          "required": true
        },
        {
          "bounds": {
            "sizeMin": 1
          },
          "name": "handle",
          "type": "string",
          "required": true
        }
      ]
    },
    "article": {
      "durability": "server",
      "fields": [
        {
          "default": "gen_random_uuid()",
          "name": "id",
          "pk": true,
          "type": "uuid",
          "required": true
        },
        {
          "default": "auth_uid()",
          "name": "author_id",
          "type": "uuid",
          "required": true
        },
        {
          "bounds": {
            "sizeMin": 1,
            "sizeMax": 200
          },
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "bounds": {
            "sizeMax": 300
          },
          "name": "description",
          "type": "string",
          "required": false
        },
        {
          "bounds": {
            "sizeMin": 1
          },
          "name": "body",
          "type": "string",
          "required": true
        },
        {
          "bounds": {
            "sizeMax": 200
          },
          "name": "tags",
          "type": "string",
          "required": false
        },
        {
          "bounds": {
            "sizeMax": 2048
          },
          "name": "cover_url",
          "type": "string",
          "required": false
        },
        {
          "bounds": {
            "sizeMax": 120
          },
          "name": "cover_credit",
          "type": "string",
          "required": false
        },
        {
          "bounds": {
            "sizeMin": 1
          },
          "name": "slug",
          "type": "string",
          "required": true,
          "unique": true
        },
        {
          "default": "now()",
          "name": "created_at",
          "type": "timestamp",
          "required": true
        },
        {
          "default": "now()",
          "name": "updated_at",
          "type": "timestamp",
          "required": true
        },
        {
          "name": "search",
          "type": "tsvector",
          "required": true
        },
        {
          "name": "reading_minutes",
          "type": "int32",
          "required": true
        }
      ]
    },
    "article_tag": {
      "durability": "server",
      "fields": [
        {
          "default": "gen_random_uuid()",
          "name": "id",
          "pk": true,
          "type": "uuid",
          "required": true
        },
        {
          "name": "article_id",
          "type": "uuid",
          "required": true
        },
        {
          "bounds": {
            "sizeMin": 1,
            "sizeMax": 40
          },
          "name": "tag",
          "type": "string",
          "required": true
        }
      ],
      "uniques": [
        {
          "name": "uq_article_tag_pair",
          "cols": [
            "article_id",
            "tag"
          ]
        }
      ]
    },
    "comment": {
      "durability": "server",
      "fields": [
        {
          "default": "gen_random_uuid()",
          "name": "id",
          "pk": true,
          "type": "uuid",
          "required": true
        },
        {
          "name": "article_id",
          "type": "uuid",
          "required": true
        },
        {
          "default": "auth_uid()",
          "name": "author_id",
          "type": "uuid",
          "required": true
        },
        {
          "bounds": {
            "sizeMin": 1,
            "sizeMax": 2000
          },
          "name": "body",
          "type": "string",
          "required": true
        },
        {
          "default": "now()",
          "name": "created_at",
          "type": "timestamp",
          "required": true
        }
      ]
    },
    "favorite": {
      "durability": "server",
      "fields": [
        {
          "default": "gen_random_uuid()",
          "name": "id",
          "pk": true,
          "type": "uuid",
          "required": true
        },
        {
          "default": "auth_uid()",
          "name": "user_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "article_id",
          "type": "uuid",
          "required": true
        },
        {
          "default": "now()",
          "name": "created_at",
          "type": "timestamp",
          "required": true
        },
        {
          "name": "deleted_at",
          "type": "timestamp",
          "required": false
        }
      ],
      "uniques": [
        {
          "name": "uq_favorite_pair",
          "cols": [
            "user_id",
            "article_id"
          ]
        }
      ]
    },
    "bookmark": {
      "durability": "server",
      "fields": [
        {
          "default": "gen_random_uuid()",
          "name": "id",
          "pk": true,
          "type": "uuid",
          "required": true
        },
        {
          "default": "auth_uid()",
          "name": "user_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "article_id",
          "type": "uuid",
          "required": true
        },
        {
          "default": "now()",
          "name": "created_at",
          "type": "timestamp",
          "required": true
        }
      ],
      "uniques": [
        {
          "name": "uq_bookmark_pair",
          "cols": [
            "user_id",
            "article_id"
          ]
        }
      ]
    },
    "follow": {
      "durability": "server",
      "fields": [
        {
          "default": "gen_random_uuid()",
          "name": "id",
          "pk": true,
          "type": "uuid",
          "required": true
        },
        {
          "default": "auth_uid()",
          "name": "follower_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "followed_id",
          "type": "uuid",
          "required": true
        },
        {
          "default": "now()",
          "name": "created_at",
          "type": "timestamp",
          "required": true
        }
      ],
      "uniques": [
        {
          "name": "uq_follow_pair",
          "cols": [
            "follower_id",
            "followed_id"
          ]
        }
      ]
    },
    "favorite_count": {
      "durability": "live",
      "fields": [
        {
          "name": "id",
          "pk": true,
          "type": "string",
          "required": true
        },
        {
          "name": "user_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "article_id",
          "type": "uuid",
          "required": true
        },
        {
          "bounds": {
            "intMin": 0,
            "intMax": 1
          },
          "name": "mine_counted",
          "type": "int32",
          "required": true
        },
        {
          "bounds": {
            "intMin": 0
          },
          "name": "total_at_read",
          "type": "int32",
          "required": true
        },
        {
          "name": "as_of_txid",
          "type": "int64",
          "required": false
        }
      ],
      "uniques": [
        {
          "name": "uq_favorite_count_pair",
          "cols": [
            "user_id",
            "article_id"
          ]
        }
      ]
    },
    "article_stats": {
      "durability": "live",
      "fields": [
        {
          "name": "article_id",
          "pk": true,
          "type": "uuid",
          "required": true
        },
        {
          "bounds": {
            "intMin": 0
          },
          "name": "favorite_count",
          "type": "int32",
          "required": true
        },
        {
          "bounds": {
            "intMin": 0
          },
          "name": "counted_txid",
          "type": "int64",
          "required": true
        }
      ]
    },
    "tag_count": {
      "durability": "live",
      "fields": [
        {
          "bounds": {
            "sizeMin": 1
          },
          "name": "id",
          "pk": true,
          "type": "string",
          "required": true
        },
        {
          "bounds": {
            "intMin": 0
          },
          "name": "article_count",
          "type": "int32",
          "required": true
        }
      ]
    },
    "favorite_index": {
      "durability": "live",
      "fields": [
        {
          "bounds": {
            "sizeMin": 1
          },
          "name": "id",
          "pk": true,
          "type": "string",
          "required": true
        },
        {
          "name": "user_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "article_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "active",
          "type": "bool",
          "required": true
        },
        {
          "name": "favorited_at",
          "type": "timestamp",
          "required": true
        }
      ]
    }
  },
  "types": {
    "types": {
      "string": {
        "sql": "portable_string",
        "base": [
          "text",
          "varchar",
          "bpchar",
          "tsvector"
        ],
        "json": "string",
        "refuse": "\\x00",
        "order": "text",
        "beyond": [
          "scalar-values"
        ]
      },
