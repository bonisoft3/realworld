{
  "access": {
    "app_user": {
      "scope": "public"
    },
    "me": {
      "owner": "id",
      "scope": "private"
    },
    "article": {
      "scope": "public"
    },
    "article_tag": {
      "scope": "public"
    },
    "comment": {
      "scope": "public"
    },
    "favorite": {
      "owner": "user_id",
      "scope": "private"
    },
    "bookmark": {
      "owner": "user_id",
      "scope": "private"
    },
    "follow": {
      "owner": "follower_id",
      "scope": "private"
    },
    "favorite_count": {
      "owner": "user_id",
      "scope": "private"
    },
    "article_stats": {
      "scope": "public"
    },
    "tag_count": {
      "scope": "public"
    },
    "favorite_index": {
      "scope": "public"
    }
  },
  "app": "realworld",
  "auth": {
    "required": true,
    "service": "/auth",
    "mode": "passkey",
    "self": {
      "route": "profile",
      "name": {
        "table": "app_user",
        "column": "display_name"
      }
    }
  },
  "floors": {
    "touch": 24
  },
  "i18n": {
    "default": "en",
    "locales": {
      "en": {
        "path": "en"
      },
      "zh": {
        "path": "zh"
      },
      "hi": {
        "path": "hi"
      },
      "es": {
        "path": "es"
      },
      "fr": {
        "path": "fr"
      },
      "ar": {
        "path": "ar"
      },
      "bn": {
        "path": "bn"
      },
      "pt": {
        "path": "pt"
      },
      "ru": {
        "path": "ru"
      },
      "ur": {
        "path": "ur"
      },
      "id": {
        "path": "id"
      },
      "de": {
        "path": "de"
      },
      "ja": {
        "path": "ja"
      },
      "sw": {
        "path": "sw"
      },
      "tr": {
        "path": "tr"
      }
    }
  },
  "keys": {
    "article_stats": "article_id"
  },
  "native": true,
  "server": true,
  "routes": [
    {
      "path": "/",
      "screen": "home",
      "nav": {
        "key": "nav_home",
        "label": "Community",
        "labels": {
          "en": "Community",
          "zh": "社区",
          "hi": "समुदाय",
          "es": "Comunidad",
          "fr": "Communauté",
          "ar": "المجتمع",
          "bn": "কমিউনিটি",
          "pt": "Comunidade",
          "ru": "Сообщество",
          "ur": "کمیونٹی",
          "id": "Komunitas",
          "de": "Community",
          "ja": "コミュニティ",
          "sw": "Jamii",
          "tr": "Topluluk"
        }
      },
      "files": {
        "html": "shell/screens/home.html",
        "css": "shell/screens/home.css",
        "handlers": [],
        "adapters": [],
        "shared": [
          "shell/shared/chrome.css",
          "shell/shared/system.css"
        ]
      },
      "ssr": "ssr",
      "states": [
        "loading",
        "empty",
        "populated",
        "favorited",
