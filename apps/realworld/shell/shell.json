          "shell/shared/chrome.css",
          "shell/shared/system.css"
        ]
      },
      "ssr": "spa",
      "states": [
        "loading",
        "populated",
        "validation-error",
        "success",
        "populated-dark"
      ]
    },
    {
      "path": "/settings",
      "screen": "settings",
      "nav": {
        "label": "Settings",
        "strip": false
      },
      "files": {
        "html": "shell/screens/settings.html",
        "css": "shell/screens/settings.css",
        "handlers": [],
        "adapters": [],
        "shared": [
          "shell/shared/chrome.css",
          "shell/shared/system.css"
        ]
      },
      "ssr": "spa",
      "states": [
        "loading",
        "populated",
        "success",
        "populated-dark"
      ]
    },
    {
      "keep": 3,
      "path": "/older/:when",
      "screen": "older",
      "nav": {
        "label": "Older writing"
      },
      "files": {
        "html": "shell/screens/older.html",
        "css": "shell/screens/older.css",
        "handlers": [],
        "adapters": [],
        "shared": [
          "shell/shared/chrome.css",
          "shell/shared/system.css"
        ]
      },
      "ssr": "ssr",
      "states": [
        "loading",
        "populated",
        "empty",
        "populated-dark"
      ]
    },
    {
      "keep": 3,
      "path": "/feed/older/:when",
      "screen": "feed-older",
      "nav": {
        "label": "Older in your feed"
      },
      "files": {
        "html": "shell/screens/feed-older.html",
        "css": "shell/screens/feed-older.css",
        "handlers": [],
        "adapters": [],
        "shared": [
          "shell/shared/chrome.css",
          "shell/shared/system.css"
        ]
      },
      "ssr": "spa",
      "states": [
        "loading",
        "populated",
        "empty",
        "populated-dark"
      ]
    },
    {
      "path": "/article/:slug",
      "screen": "article",
      "nav": {
        "label": "Article"
      },
      "files": {
        "html": "shell/screens/article.html",
        "css": "shell/screens/article.css",
        "handlers": [],
        "adapters": [],
        "renderers": [
          "shell/renderers/markdown.js"
        ],
        "shared": [
          "shell/shared/chrome.css",
          "shell/shared/system.css"
        ]
      },
      "ssr": "ssr",
      "states": [
        "loading",
        "populated",
        "validation-error",
        "owner",
        "delete-armed",
        "no-comments",
        "gone",
        "populated-dark"
      ]
    },
    {
      "keep": 0,
      "path": "/editor/:id",
      "screen": "edit-article",
      "nav": {
        "label": "Edit Article"
      },
      "files": {
        "html": "shell/screens/edit-article.html",
        "css": "shell/screens/edit-article.css",
        "handlers": [],
        "adapters": [],
        "shared": [
          "shell/shared/chrome.css",
          "shell/shared/system.css"
        ]
      },
      "ssr": "spa",
      "states": [
        "loading",
        "populated",
        "validation-error",
        "success",
        "empty",
        "populated-dark"
      ]
    },
    {
      "keep": 2,
      "path": "/profile/:handle",
      "screen": "profile",
      "nav": {
        "label": "Profile"
      },
      "files": {
        "html": "shell/screens/profile.html",
        "css": "shell/screens/profile.css",
        "handlers": [],
        "adapters": [],
        "shared": [
          "shell/shared/chrome.css",
          "shell/shared/system.css"
        ]
      },
      "ssr": "ssr",
      "states": [
        "loading",
        "populated",
        "following",
        "own-profile",
        "empty",
        "populated-dark"
      ]
    },
    {
      "path": "/profile/:handle/favorites",
      "screen": "profile-favorites",
      "nav": {
        "label": "Favorited"
      },
      "files": {
        "html": "shell/screens/profile-favorites.html",
        "css": "shell/screens/profile-favorites.css",
        "handlers": [],
        "adapters": [],
        "shared": [
          "shell/shared/chrome.css",
          "shell/shared/system.css"
        ]
      },
      "ssr": "ssr",
      "states": [
        "loading",
        "populated",
        "empty",
        "populated-dark"
      ]
    },
    {
      "keep": 3,
      "path": "/tag/:name",
      "screen": "tag",
      "nav": {
        "label": "Tag"
      },
      "files": {
        "html": "shell/screens/tag.html",
        "css": "shell/screens/tag.css",
        "handlers": [],
        "adapters": [],
        "shared": [
          "shell/shared/chrome.css",
          "shell/shared/system.css"
        ]
      },
      "ssr": "ssr",
      "states": [
        "loading",
        "populated",
        "empty",
        "populated-dark"
      ]
    },
    {
      "path": "/search/:q",
      "screen": "search",
      "nav": {
        "label": "Search"
      },
      "files": {
        "html": "shell/screens/search.html",
        "css": "shell/screens/search.css",
        "handlers": [],
        "adapters": [],
        "shared": [
          "shell/shared/chrome.css",
          "shell/shared/system.css"
