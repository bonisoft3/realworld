  "cmds": [
    {
      "srcs": {
        "globs": [
          ".bayt/**"
        ],
        "exclude": [],
        "defaultGlobs": null,
        "defaultExclude": null
      },
      "do": "set -eu\nexport DOCKER_HOST_TCP=\"$DOCKER_HOST\"\nexport DEPOT_DISABLE_OTEL=1\ndocker compose --profile '*' config -o /tmp/ci-compose.yaml\ndocker buildx bake --allow=fs.read=/ -f /tmp/ci-compose.yaml --print ci-android ci-visual ci-replay ci-favorites > /tmp/ci-bake.json\nfor target in ci-android ci-visual ci-replay ci-favorites; do\n docker buildx bake -f /tmp/ci-bake.json --progress plain --set '*.output=type=cacheonly' ${SAYT_NO_CACHE:+--no-cache --set \"*.cache-from=\" --set \"*.cache-to=\"} ${SAYT_NO_CACHE_FROM:+--set \"*.cache-from=\"} ${SAYT_NO_CACHE_TO:+--set \"*.cache-to=\"} \"$target\"\ndone",
      "shell": "sh",
      "dockerfile": {
        "inject": {
          "secrets": [
            {
              "id": "docker_host",
              "var": {
                "contents": "DOCKER_HOST"
              }
            },
            {
              "id": "buildx_builder",
              "var": {
                "contents": "BUILDX_BUILDER"
              }
            },
            {
              "id": "testcontainers_host",
              "var": {
                "contents": "TESTCONTAINERS_HOST_OVERRIDE"
              }
            },
            {
              "id": "cache_scope",
              "var": {
                "contents": "CACHE_SCOPE"
              }
            },
            {
              "id": "cache_scope_fallback",
              "var": {
                "contents": "CACHE_SCOPE_FALLBACK"
              }
            },
            {
              "id": "sayt_buildkit_syntax",
              "var": {
                "contents": "BUILDKIT_SYNTAX"
              }
            },
            {
              "id": "sayt_no_cache",
              "var": {
                "contents": "SAYT_NO_CACHE"
              }
            },
            {
              "id": "bayt_image_tag",
              "var": {
                "contents": "BAYT_IMAGE_TAG"
              }
            },
            {
              "id": "bayt_pull_policy",
              "var": {
                "contents": "BAYT_PULL_POLICY"
              }
            },
            {
              "id": "sayt_no_cache_from",
              "var": {
                "contents": "SAYT_NO_CACHE_FROM"
              }
            },
            {
              "id": "sayt_no_cache_to",
              "var": {
                "contents": "SAYT_NO_CACHE_TO"
              }
            },
            {
              "id": "depot_token",
              "var": {
                "contents": "DEPOT_TOKEN"
              }
            },
            {
              "id": "depot_project_id",
              "var": {
                "contents": "DEPOT_PROJECT_ID"
              }
            },
            {
              "id": "depot_org_id",
              "var": {
                "contents": "DEPOT_ORG_ID"
              }
            },
            {
              "id": "depot_disable_otel",
              "var": {
                "contents": "DEPOT_DISABLE_OTEL"
              }
            },
            {
              "id": "actions_results_url",
              "var": {
                "contents": "ACTIONS_RESULTS_URL"
              }
            },
            {
              "id": "actions_runtime_token",
              "var": {
                "contents": "ACTIONS_RUNTIME_TOKEN"
              }
            },
            {
              "id": "bkid_project",
              "var": {
                "contents": "BKID_PROJECT"
              }
            },
            {
              "id": "buildx_instance",
              "var": {
                "contents": "BUILDX_INSTANCE"
              }
            },
            {
              "id": "docker_config",
              "var": {
                "contents": "DOCKER_AUTH_CONFIG",
                "path": "/root/.docker/config.json"
              },
              "mode": "0600"
            }
          ],
          "defaultSteps": {
            "buildx-instance": {
              "name": "buildx-instance",
              "priority": 11,
              "pre": "if [ -n \"$BUILDX_BUILDER\" ] && [ -n \"$BUILDX_INSTANCE\" ]; then\n  install -d -m 0700 /root/.docker/buildx/instances\n  printf '%s' \"$BUILDX_INSTANCE\" > \"/root/.docker/buildx/instances/$BUILDX_BUILDER\"\n  chmod 0600 \"/root/.docker/buildx/instances/$BUILDX_BUILDER\"\nfi"
            },
            "unix-socket-forward": {
              "name": "unix-socket-forward",
              "priority": 10,
              "pre": "if [ -n \"$DOCKER_HOST\" ] && [ ! -e /var/run/docker.sock ]; then\n  ulimit -n 1048576 2>/dev/null || true\n  addr=${DOCKER_HOST#tcp://}\n  [ -n \"$addr\" ] || { echo \"bkid: DOCKER_HOST=$DOCKER_HOST has no tcp:// address\" >&2; exit 1; }\n  socat -d0 -t 86400 UNIX-LISTEN:/var/run/docker.sock,fork,backlog=1024,reuseaddr \"TCP:$addr,keepalive,keepidle=30,keepintvl=15,keepcnt=4\" &\n  SOCAT_PID=$!\n  trap 'kill $SOCAT_PID 2>/dev/null || true' EXIT INT TERM\n  socat -u OPEN:/dev/null UNIX-CONNECT:/var/run/docker.sock,retry=20,interval=0.2 >/dev/null 2>&1 \\\n    || { echo \"bkid: socat bridge to /var/run/docker.sock not ready\" >&2; exit 1; }\nfi"
            }
          },
          "steps": []
        }
      },
      "name": "builtin",
      "stop": false
    }
  ],
  "cache": {
    "full": false,
    "similar": false
  }
