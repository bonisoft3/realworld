FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS served_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents shell/index.html shell/shell.css shell/boot.js offline-first-sw.js shell/shell.yaml shell/shell.json shell/design.css shell/screens/home.html shell/screens/home.css shell/screens/feed.html shell/screens/feed.css shell/screens/reading-list.html shell/screens/reading-list.css shell/screens/editor.html shell/screens/editor.css shell/screens/settings.html shell/screens/settings.css shell/screens/older.html shell/screens/older.css shell/screens/feed-older.html shell/screens/feed-older.css shell/screens/article.html shell/screens/article.css shell/screens/edit-article.html shell/screens/edit-article.css shell/screens/profile.html shell/screens/profile.css shell/screens/profile-favorites.html shell/screens/profile-favorites.css shell/screens/tag.html shell/screens/tag.css shell/screens/search.html shell/screens/search.css shell/renderers/markdown.js shell/shared/chrome.css shell/shared/system.css pipelines/favorite-recount.js messages/en.json messages/zh.json messages/hi.json messages/es.json messages/fr.json messages/ar.json messages/bn.json messages/pt.json messages/ru.json messages/ur.json messages/id.json messages/de.json messages/ja.json messages/sw.json messages/tr.json journal.html ir.html ir/card.css acceptance.md DESIGN.md journal/2026-10-18-login-after-dark.png journal/2026-10-18-login-after-desktop.png journal/2026-10-18-login-after-mobile.png journal/2026-10-18-login-before-dark.png journal/2026-10-18-login-before-desktop.png journal/2026-10-18-login-before-mobile.png journal/2026-10-28-cloudflare-article.png journal/2026-10-28-cloudflare-feed.png journal/2026-10-28-cloudflare-mobile.png robots.txt sitemap.xml ./
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS served_srcs
COPY --from=served_ctxs /monorepo /monorepo

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS served_bayt_ctxs
